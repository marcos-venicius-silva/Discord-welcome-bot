# Token do bot (Discord Developer Portal)
DISCORD_TOKEN=seu_token_aqui

# ID do cliente/aplicação do bot
CLIENT_ID=seu_client_id_aqui

# String de conexão do MongoDB
MONGODB_URI=mongodb://localhost:27017/welcome-bot

# (Opcional) ID de um servidor para registrar os comandos instantaneamente em modo dev
DEV_GUILD_ID=

# ID de usuários que sempre têm acesso total ao painel (dono do bot), separados por vírgula
BOT_OWNERS=
